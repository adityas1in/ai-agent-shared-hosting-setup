# AI Agent Configuration
# Apne shared hosting par Python service ki URL
# 
# Local development:
# AI_AGENT_URL=http://localhost:5000/api
#
# Shared hosting (same server):
# AI_AGENT_URL=http://127.0.0.1:5000/api
#
# Separate server:
# AI_AGENT_URL=http://your-server-ip:5000/api

AI_AGENT_URL=http://127.0.0.1:5000/api
AI_AGENT_TIMEOUT=30
