# Groq API Key
# https://console.groq.com par free account banao
# Apni API key copy karo
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Flask Settings
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# CORS Settings (aapki website ka domain)
ALLOWED_ORIGINS=http://localhost,https://apki-website.com

# Logging
LOG_LEVEL=INFO
